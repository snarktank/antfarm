# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# OpenAI API Key for agent operations
OPENAI_API_KEY=sk-your-openai-key-here

# Gateway Password (for local gateway authentication)
GATEWAY_PASSWORD=your-secure-password-here

# Telegram Bot Token (if using Telegram integration)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Server port (optional, defaults to 3000)
PORT=3000

# Database file path (optional, defaults to in-memory or antfarm.db)
DATABASE_PATH=./antfarm.db
