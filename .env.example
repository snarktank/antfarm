# Antfarm Environment Variables
# Copy this file to .env and fill in your actual values

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PASSWORD=your_gateway_password_here

# OpenClaw State Directory (optional - defaults to ~/.openclaw)
# OPENCLAW_STATE_DIR=/path/to/custom/state

# OpenClaw Config Path (optional)
# OPENCLAW_CONFIG_PATH=/path/to/config.yaml

# User home directory (usually auto-detected)
# HOME=/home/username
